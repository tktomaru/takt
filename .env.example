# TAKT Environment Configuration
# Copy this file to .env and modify as needed

# Anthropic API Key (required for Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Model override
# Use this to specify a different model than the default
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Extra CLI arguments for Claude (JSON format)
# Example: Override API base for local models
# CLAUDE_EXTRA_ARGS={"api-base": "http://localhost:11434/v1"}

# Environment variables to pass to Claude process
# Prefix with CLAUDE_ENV_ and the suffix becomes the actual env var name
# Example: CLAUDE_ENV_MY_VAR=value -> passes MY_VAR=value to Claude
